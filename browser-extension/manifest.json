{
  "manifest_version": 3,
  "name": "FocusGuard Browser Monitor",
  "version": "0.3.0",
  "description": "Reports the active tab in every Edge window to the local FocusGuard service.",
  "permissions": [
    "tabs",
    "alarms",
    "storage",
    "windows"
  ],
  "host_permissions": [
    "http://127.0.0.1:37831/*",
    "http://localhost:37831/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
